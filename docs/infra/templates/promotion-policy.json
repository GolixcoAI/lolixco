{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadVerifiedStaging",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::${MEDIA_BUCKET}/staging/*"
    },
    {
      "Sid": "CopyApprovedArtifacts",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::${MEDIA_BUCKET}/optimized/*",
        "arn:aws:s3:::${MEDIA_BUCKET}/posters/*"
      ],
      "Condition": {
        "StringLike": {
          "s3:x-amz-copy-source": "${MEDIA_BUCKET}/staging/*"
        }
      }
    },
    {
      "Sid": "RevokeDelivery",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::${MEDIA_BUCKET}/optimized/*",
        "arn:aws:s3:::${MEDIA_BUCKET}/posters/*"
      ]
    },
    {
      "Sid": "InvalidateReviewedPaths",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::${ACCOUNT_ID}:distribution/${DISTRIBUTION_ID}"
    }
  ]
}
