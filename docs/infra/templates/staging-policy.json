{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStaging",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${MEDIA_BUCKET}",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["staging/*"]
        }
      }
    },
    {
      "Sid": "UploadStaging",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::${MEDIA_BUCKET}/staging/*"
    },
    {
      "Sid": "DenyAnyDeliveryWrite",
      "Effect": "Deny",
      "Action": ["s3:PutObject", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::${MEDIA_BUCKET}/optimized/*",
        "arn:aws:s3:::${MEDIA_BUCKET}/posters/*"
      ]
    }
  ]
}
