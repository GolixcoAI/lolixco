{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateDedicatedMumbaiBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket"
      ],
      "Resource": "arn:aws:s3:::${MEDIA_BUCKET}",
      "Condition": {
        "StringEquals": {
          "s3:LocationConstraint": "ap-south-1"
        }
      }
    },
    {
      "Sid": "ConfigureDedicatedBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketOwnershipControls",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketVersioning",
        "s3:PutBucketPolicy",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketTagging"
      ],
      "Resource": "arn:aws:s3:::${MEDIA_BUCKET}"
    }
  ]
}
