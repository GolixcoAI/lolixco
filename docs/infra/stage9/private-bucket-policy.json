{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::${MEDIA_BUCKET}",
        "arn:aws:s3:::${MEDIA_BUCKET}/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "NeverServePrivatePrefixesThroughCloudFront",
      "Effect": "Deny",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::${MEDIA_BUCKET}/staging/*",
        "arn:aws:s3:::${MEDIA_BUCKET}/masters/*",
        "arn:aws:s3:::${MEDIA_BUCKET}/audit/*",
        "arn:aws:s3:::${MEDIA_BUCKET}/quarantine/*"
      ]
    }
  ]
}
