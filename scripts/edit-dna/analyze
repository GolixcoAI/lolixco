#!/usr/bin/env bash
# LOLIXCO EDIT DNA — UNIFIED OFFLINE ANALYSIS CLI
# Usage: ./scripts/edit-dna/analyze <video.mp4> [--output <report.json>] [--format summary|json|both]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PYTHON="/home/rohan/.venvs/lolixco-antigravity/bin/python3"

if [ -x "$VENV_PYTHON" ]; then
  PYTHON_BIN="$VENV_PYTHON"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="$(command -v python3)"
else
  echo "Error: Python 3 not found." >&2
  exit 1
fi

exec "$PYTHON_BIN" "$SCRIPT_DIR/offline_analyzer.py" "$@"
