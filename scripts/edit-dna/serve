#!/usr/bin/env bash
# Lolixco Edit DNA — Local Analysis Service Runner (Phase 8)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
VENV_PYTHON="/home/rohan/.venvs/lolixco-antigravity/bin/python3"

if [ ! -f "$VENV_PYTHON" ]; then
    echo "[ERROR] Virtualenv python not found: $VENV_PYTHON"
    exit 1
fi

export PYTHONPATH="$PROJECT_ROOT/scripts/edit-dna:${PYTHONPATH:-}"
exec "$VENV_PYTHON" "$SCRIPT_DIR/local_service.py" "$@"
